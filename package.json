{
  "name": "lumen",
  "version": "1.0.0",
  "description": "Self-hosted chat UI for local LLMs (Ollama). Needs Node 22+ (the current LTS; Node 18 and 20 are end-of-life).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "app": "node bin/lumen-app.js",
    "test": "tests/run.sh",
    "desktop": "electron desktop/main.js",
    "dist:mac": "npx --yes electron-builder@26 --mac --dir"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "diff": "^7.0.0",
    "pdf-parse": "^1.1.1"
  },
  "bin": {
    "lumen": "bin/lumen-app.js"
  },
  "devDependencies": {
    "electron": "^38.8.6"
  },
  "allowScripts": {
    "electron@38.8.6": true
  },
  "build": {
    "appId": "local.lumen.app",
    "productName": "Lumen",
    "files": [
      "*.js",
      "!tests/**",
      "starter-skills/**",
      "public/**",
      "desktop/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "protocols": [
      {
        "name": "Lumen",
        "schemes": [
          "lumen"
        ]
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null,
      "category": "public.app-category.productivity",
      "icon": "public/icon-512.png"
    }
  }
}
